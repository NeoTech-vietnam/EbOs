  "conformance_claim": false,
  "runtime_limitations": {
    "tasks": "C-only fully preemptive basic tasks, one explicitly pinned core, distinct native priorities, no blocking entries",
    "activation": "Limit includes current activation and queued requests; initialization does not activate tasks",
    "nonlocal_exit": "Successful termination/chaining use same-worker C nonlocal exits; no VLA or C++ destruction frames",
    "lifecycle": "Init/deinit are externally serialized with all six task services; immutable configuration remains alive until successful deinit",
    "contexts": "Native ISR calls rejected; no AUTOSAR category 2 ISR bridge; suspended scheduler rejected",
    "missing_end": "Optional NeoTech diagnostic before retirement, not standard ErrorHook or Pre/PostTaskHook",
    "unsupported": [
      "non-preemptive tasks",
      "equal-priority scheduling",
      "extended-task events",
      "AUTOSAR resources and spinlocks",
      "OS-Application memory/timing protection",
      "core startup/shutdown",
      "application modes"
    ],
    "target_acceptance": "Pending physical ESP32-S3 verification; host tests do not prove target scheduling"
  }
}
