    },
    "SWS_Os_00001": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 37,
      "section": "7.1.2",
      "summary": "Provide the OSEK-compatible OS interface; this contract does not establish runtime compatibility.",
      "status": "context_only_not_satisfied_by_declarations",
      "upstream": [
        "SRS_Os_00097",
