        "SRS_BSW_00345"
      ],
      "upstream_scope_note": "The BSW-general parents are external references, not independently verified or claimed by this OS-only profile."
    },
    "SWS_Os_00093": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 81,
      "section": "7.7.3.4",
      "summary": "Ignore non-interrupt OS services while interrupts are disabled or suspended; StatusType services report E_OS_DISABLEDINT.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_00424": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 39,
      "section": "7.1.2.2",
      "summary": "The initial OS startup call does not return.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_00425": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 39,
      "section": "7.1.2.2",
      "summary": "After a returning shutdown hook, interrupts are disabled and execution remains in an endless loop.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_00612": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 108,
      "section": "7.9.15",
      "summary": "In extended status, task termination or chaining while holding a spinlock reports E_OS_SPINLOCK.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_00617": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 109,
      "section": "7.9.17",
      "summary": "ShutdownOS affects the calling core.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_00624": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 111,
      "section": "7.9.20",
      "summary": "Schedule checks spinlock ownership and refuses to deschedule with E_OS_SPINLOCK in extended status.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_91007": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 160,
      "section": "8.1.1",
      "summary": "AppModeType includes DONOTCARE for inheriting an application mode from another core.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "SWS_Os_91025": {
      "origin": "AUTOSAR",
      "document": "AUTOSAR_SWS_OS",
      "page": 141,
      "section": "7.15",
      "summary": "OS development-error values in the AUTOSAR extension set are assigned by the implementation.",
      "status": "context_only_not_satisfied_by_declarations"
    },
    "NEO_EBOS_00001": {
      "origin": "NeoTech",
      "summary": "Validate output, create an opaque native mutex, and clean allocation failure.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00002": {
      "origin": "NeoTech",
      "summary": "Provide nonrecursive task-context locking with bounded or indefinite waits.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00003": {
      "origin": "NeoTech",
      "summary": "Release an owned mutex; a null handle is ignored.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00004": {
      "origin": "NeoTech",
      "summary": "Delete a quiescent mutex and release its wrapper.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00005": {
      "origin": "NeoTech",
      "summary": "Convert finite milliseconds to rounded-up saturated native ticks.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00006": {
      "origin": "NeoTech",
      "summary": "Delay for exactly one actual scheduler tick.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00007": {
      "origin": "NeoTech",
      "summary": "Validate project task configuration and safely publish a dynamically allocated native task.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00008": {
      "origin": "NeoTech",
      "summary": "Retire only after cooperative completion and confirmed native suspension; timeout preserves retry.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00009": {
      "origin": "NeoTech",
      "summary": "Report minimum unused stack, including suspension, before serialized deletion.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00010": {
      "origin": "NeoTech",
      "summary": "Keep native mutex handles opaque.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00011": {
      "origin": "NeoTech",
      "summary": "Keep managed native task handles opaque.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00012": {
      "origin": "NeoTech",
      "summary": "Accept portable, project-supplied native-task configuration.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00013": {
      "origin": "NeoTech",
      "summary": "Define an explicit indefinite-wait sentinel.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_00014": {
      "origin": "NeoTech",
      "summary": "Define the unpinned affinity sentinel.",
      "status": "implemented",
      "verification": [
        "test/test_ebos.c"
      ]
    },
    "NEO_EBOS_OS_TYPES": {
      "origin": "NeoTech",
      "summary": "Choose portable C representations, task states, sentinels and profile constants for the declaration-only OS contract. This is not an AUTOSAR type-conformance claim.",
      "status": "declarations_verified",
      "verification": [
        "test/test_os_contracts.c"
      ]
    },
    "NEO_EBOS_CFG_00001": {
      "origin": "NeoTech",
      "summary": "The integrating project owns camera task stack, priority and affinity policy.",
      "status": "implemented_in_integration",
      "verification": [
        "CamPipe/test/test_cam_pipe_backend.c"
      ]
    },
    "NEO_EBOS_CFG_00002": {
      "origin": "NeoTech",
      "summary": "The project binds CamPipe runnable execution with one native tick per continuing iteration.",
      "status": "implemented_in_integration",
      "verification": [
        "CamPipe/test/test_cam_pipe_backend.c"
      ]
    }
  },
